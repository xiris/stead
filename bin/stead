#!/usr/bin/env bash
# stead - bind a Claude Code / Codex account to a directory.
#
# Credentials are isolated per profile via CLAUDE_CONFIG_DIR / CODEX_HOME (native, and the only
# mechanism that lets two accounts be live in two terminals at once). Everything else - CLAUDE.md,
# plugins, skills, settings - is symlinked back to the real home so profiles stay in sync.
set -euo pipefail

STEAD_HOME="${STEAD_HOME:-$HOME/.stead}"
PROFILES="$STEAD_HOME/profiles"
CLAUDE_HOME="${STEAD_CLAUDE_HOME:-$HOME/.claude}"
CODEX_REAL="${STEAD_CODEX_HOME:-$HOME/.codex}"
# Sibling of $CLAUDE_HOME, not inside it: Claude Code keeps .claude.json next to ~/.claude.
CLAUDE_JSON="${STEAD_CLAUDE_JSON:-$HOME/.claude.json}"
MARKER=".stead"
VERSION="0.1.0"

# Shared back to the real home. Auth state is deliberately absent: that is the whole point.
# hooks: the DEFINITIONS live in settings.json, but the scripts they name live here. They happen to
# resolve today because the commands are absolute paths; sharing the directory means a hook written
# with a relative path does not silently stop firing inside a profile.
# settings.local.json: the permissions allowlist. Unshared, a profile re-prompts for everything.
# sessions: the peer registry. Claude Code writes <pid>.json + a <pid>.<id>.key here and discovers
# other sessions by reading it, so an unshared one makes sessions in different profiles invisible to
# ListAgents and SendMessage even though the transport - /tmp/cc-socks/<pid>.sock - is already
# global. Sharing it opens no NEW read channel: profiles isolate accounts, not the filesystem, and
# any session can already read another profile's directory. What it does enable is message CONTENT
# crossing between accounts, which is the boundary worth minding - keep messages task-shaped, and
# name sessions neutrally, because a derived name is the directory name.
CLAUDE_SHARED=(CLAUDE.md settings.json settings.local.json plugins skills agents commands hooks sessions)
CODEX_SHARED=(config.toml plugins skills)
# Claude Code creates these on demand, so an absent source means "not used yet", not "the user does
# not want it shared" - unlike agents/ or commands/, which exist only if the user made them. Without
# creating it, someone who only ever runs claude through stead never has ~/.claude/sessions, so
# each_shared filters the entry out, every profile keeps its own real registry, sessions stay
# mutually invisible, and doctor reports healthy forever.
CLAUDE_ONDEMAND=(sessions)

die()  { printf 'stead: %s\n' "$*" >&2; exit 1; }
warn() { printf 'stead: %s\n' "$*" >&2; }

# each_shared encodes paths into tab-separated fields, so a tab or newline in any of these roots
# splits one entry into two and hands a consumer a path it never built. That consumer includes a
# `rm -rf` loop, and the mis-parsed path is RELATIVE, so it resolves against the user's cwd - a
# delete outside $PROFILES entirely. Refuse at startup instead: this is a trust boundary, same as
# valid_name. Guards STEAD_HOME too, which is safe today only because dst happens to be the last
# field; that is not a property worth making load-bearing.
# shell-init is exempt: it prints a static heredoc and touches no path. If it died here the
# wrapper functions would never be DEFINED, and every directory in that shell - bound ones
# included - would silently run the default account. Letting it through means the functions exist
# and refuse properly at `stead which` time, with exit 2.
case "${1-}" in shell-init) ;; *)
case "$STEAD_HOME$CLAUDE_HOME$CODEX_REAL" in
	*$'\t'* | *$'\n'*)
		# Exit 2, NOT die's 1. _stead_exec reads 1 as "unbound, run the real binary", so
		# dying here would launch a bound client repo on the default account - the very
		# outcome resolve() fails closed to avoid. 2 is the wrapper's "refuse" code.
		warn "a tab or newline in a stead home path is not supported (STEAD_HOME / CLAUDE_HOME / CODEX_HOME)"
		exit 2
		;;
esac
;; esac

# Profile names land in filesystem paths and in argv, so validate before use. Rejects empty,
# dot-leading (blocks . and ..), dash-leading (would be read as an option) and anything outside a
# conservative charset.
valid_name() {
	case "${1-}" in
		'' | [-.]* | *[!A-Za-z0-9._-]*) return 1 ;;
		*) return 0 ;;
	esac
}

require_profile() {
	valid_name "$1" || die "invalid profile name: '$1' (use letters, digits, . _ -)"
	[ -d "$PROFILES/$1" ] || die "no such profile: $1 (create it with: stead add $1)"
}

# Walk up from the working directory looking for the marker. Prints the profile name on stdout.
# Exit 1 = no marker (use the default account). Exit 2 = marker present but unusable.
# These MUST stay distinct: treating a corrupt marker as "unbound" silently runs a client's repo on
# your personal account, which is the exact failure this tool exists to prevent. Fail closed.
resolve() {
	local dir name
	# -P so a symlinked path walks its real parents. It took an optional directory argument once,
	# and nothing ever passed one.
	dir=$(pwd -P) || return 1
	while :; do
		if [ -f "$dir/$MARKER" ]; then
			# Strips surrounding whitespace and CR (CRLF markers), keeps internal spaces so
			# "a b" stays invalid instead of collapsing into the valid name "ab", and reads
			# only the first line.
			IFS=$' \t\r\n' read -r name <"$dir/$MARKER" || :
			if ! valid_name "${name-}"; then
				warn "$dir/$MARKER does not name a valid profile - refusing to guess an account"
				return 2
			fi
			if [ ! -d "$PROFILES/$name" ]; then
				warn "$dir/$MARKER names profile '$name', which does not exist - run: stead add $name"
				return 2
			fi
			printf '%s' "$name"
			return 0
		fi
		[ "$dir" = "/" ] && return 1
		dir=$(dirname "$dir")
	done
}

# A profile is a directory under $PROFILES. Anything else in there (a stray README, a .DS_Store)
# is not one: `ls -1` used to hand those to link_shared, which aborted the entire --fix run on the
# first `ln: .../README/claude/CLAUDE.md: Not a directory` and left real breaks unrepaired.
profile_names() {
	local d
	for d in "$PROFILES"/*/; do
		[ -d "$d" ] || continue          # no match: the glob stays literal
		d=${d%/}
		d=${d##*/}
		# Same stance as the home-path guard: a name with a tab or newline would ride into the
		# encoding, and "dst is the last field" is not a property worth making load-bearing.
		valid_name "$d" || continue
		printf '%s\n' "$d"
	done
}

# ln -sfn: -n keeps a directory symlink from being followed into on relink.
link_one() {
	local src=$1 dst=$2
	[ -e "$src" ] || return 0
	mkdir -p "${dst%/*}" 2>/dev/null || return 0   # recreate a profile's missing claude/ or codex/ half
	if [ -e "$dst" ] && [ ! -L "$dst" ]; then
		warn "not linking $dst - a real file is already there (run 'stead doctor' for details)"
		return 0
	fi
	ln -sfn "$src" "$dst"
}

# Emits every shared link for a profile as "<label>\t<src>\t<dst>". The single source of truth for
# what is shared: link_shared and doctor both read it, so doctor cannot fall behind the lists again.
#
# Entries with no source in the real home are filtered out HERE, not by each consumer. One of those
# consumers is a `rm -rf` loop: if it sees an entry we never linked (because the source is absent),
# it deletes whatever the profile has at that path and link_shared cannot put it back, since there
# is nothing to link to. That is silent, unrecoverable data loss right after doctor called the
# profile healthy. Filtering at the source is what makes it impossible to forget.
each_shared() {
	local name=$1 f
	for f in "${CLAUDE_SHARED[@]}"; do
		[ -e "$CLAUDE_HOME/$f" ] && printf 'claude/%s\t%s\t%s\n' "$f" "$CLAUDE_HOME/$f" "$PROFILES/$name/claude/$f"
	done
	for f in "${CODEX_SHARED[@]}"; do
		[ -e "$CODEX_REAL/$f" ] && printf 'codex/%s\t%s\t%s\n' "$f" "$CODEX_REAL/$f" "$PROFILES/$name/codex/$f"
	done
	return 0
}

# A real DIRECTORY in a profile can hold state that exists nowhere else. The session registry is the
# case that forced this: rm -rf there deregisters a LIVE session and destroys its IPC key, which
# Claude Code writes only at startup and never recreates - and doctor's own printed remedy is what
# would do it. Move the contents into the shared copy instead, shared winning any collision, then
# let the caller link. A real FILE is still replaced: that is the atomic-write clobber doctor exists
# to repair, and there the shared copy really is authoritative.
merge_into_shared() {
	local src=$1 dst=$2 f b
	[ -d "$dst" ] && [ ! -L "$dst" ] || return 0
	mkdir -p "$src"
	for f in "$dst"/* "$dst"/.[!.]*; do
		[ -e "$f" ] || continue          # no match: the glob stays literal
		b=${f##*/}
		[ -e "$src/$b" ] && continue     # already in the shared copy, which wins
		mv "$f" "$src/$b"
	done
	rmdir "$dst" 2>/dev/null || true
}

link_shared() {
	local label src dst f
	for f in "${CLAUDE_ONDEMAND[@]}"; do
		if [ ! -e "$CLAUDE_HOME/$f" ]; then
			# NOT `mkdir -p -m 700`: with -p the mode applies only to the deepest directory, so a
			# $CLAUDE_HOME that also had to be created would take the umask. chmod the leaf.
			mkdir -p "$CLAUDE_HOME/$f"
			chmod 700 "$CLAUDE_HOME/$f"
		fi
	done
	# Process substitution, not a pipe: a piped `while` runs in a subshell and loses what it sets.
	while IFS=$'\t' read -r label src dst; do link_one "$src" "$dst"; done < <(each_shared "$1")
}

# The account a claude profile is signed in as, or empty. Reads .claude.json, which is the file
# Claude Code writes the resolved account into after login.
claude_account() {
	python3 -c 'import json,sys
try:
    print(json.load(open(sys.argv[1])).get("oauthAccount",{}).get("emailAddress","") or "")
except Exception:
    print("")' "$PROFILES/$1/claude/.claude.json" 2>/dev/null || true
}

# MCP servers are the one thing that cannot join CLAUDE_SHARED. They live in .claude.json, the same
# file that holds oauthAccount, so symlinking it would share the credentials and defeat the tool.
# Copying just the mcpServers key moves config instead - but "we never copy a token" cannot be held
# by a denylist of field names. A token rides in a url query string, in userinfo, in an --api-key
# arg, in a key spelled Env, in an `oauth` block a future version adds. So this is an ALLOWLIST:
# only type/command/args/url are ever written, anything else with a value gets the entry refused and
# named, and a credential-shaped url or argv is refused too. Unrecognised means refused, never
# copied - the same stance as valid_name. A wrong refusal costs one manual `claude mcp add`; a wrong
# copy puts a client's token in a personal profile.
mcp_guard() {   # <sync|audit> <source .claude.json> <profile .claude.json> <profile name>
	command -v python3 >/dev/null 2>&1 || { warn "python3 not found - skipping mcp guard"; return 0; }
	# shellcheck disable=SC2016  # the python program is data, not shell to expand
	python3 -c '
import json, math, os, re, sys, tempfile
from collections import Counter

ALLOWED = ("type", "command", "args", "url")
# Round 2 of review: replacing a denylist of field NAMES with a denylist of credential WORDS was the
# same mistake one layer down. A postgres/mysql/redis MCP server takes its DSN as a positional arg,
# so postgresql://user:password@host reached the profile and was reported as copied-clean. These
# rules therefore apply to EVERY string in an entry - url, command and each arg alike - and lead
# with shape (a uri with userinfo, a known prefix, a long high-entropy token) rather than with
# vocabulary, because a secret is defined by being unguessable, not by being labelled.
WORDS = re.compile(r"(?i)(api[-_]?key|access[-_]?token|token|secret|password|passwd|pwd|bearer|"
                   r"credential|auth|dsn|session|signature)")
URI_USERINFO = re.compile(r"[a-zA-Z][a-zA-Z0-9+.\-]*://[^/\s@]*:[^/\s@]*@")
PARAM = re.compile(r"[?#;][A-Za-z0-9_.\-]+=")
PREFIX = re.compile(r"(?:^|[^A-Za-z0-9])(gh[porsu]_|github_pat_|sk-|xox[baprs]-|AKIA|ASIA|eyJ|AIza|glpat-)")
SPLIT = re.compile(r"[/\s=:?#&;,\"\x27]+")

def opaque(tok):
    """Long and disordered enough to be a secret rather than a package, path or host name."""
    if len(tok) < 24 or "." in tok:
        return False
    if sum(bool(re.search(pat, tok)) for pat in (r"[a-z]", r"[A-Z]", r"[0-9]")) < 2:
        return False
    n = len(tok)
    ent = -sum((c / n) * math.log(c / n, 2) for c in Counter(tok).values())
    return ent >= 3.4

def why(c):
    """Reason this entry must not be copied, or None."""
    if not isinstance(c, dict):
        return "not an object"
    dropped = sorted(k for k in c if k not in ALLOWED and c.get(k))
    if dropped:
        return "field(s) I will not copy blind: " + ", ".join(dropped)
    url, cmd, args = c.get("url"), c.get("command"), c.get("args")
    if url is not None and not isinstance(url, str):
        return "url is not a string"
    if cmd is not None and not isinstance(cmd, str):
        return "command is not a string"
    if args is not None and not isinstance(args, list):
        return "args is not a list"
    strings = [x for x in ([url, cmd] + list(args or [])) if x is not None]
    if any(not isinstance(x, str) for x in strings):
        return "args contains a non-string"
    for x in strings:
        if URI_USERINFO.search(x):
            return "a uri with an embedded username and password"
        if PARAM.search(x):
            return "a url parameter that could carry a credential"
        if PREFIX.search(x):
            return "a recognisable credential prefix"
        if WORDS.search(x):
            return "text that names a credential"
        for tok in SPLIT.split(x):
            if opaque(tok):
                return "a long high-entropy token that looks like a secret"
    if not (cmd or url):
        return "neither a command nor a url to copy"
    return None

mode, src_p, dst_p, name = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

if mode == "audit":
    # A profile synced by an older, looser guard keeps exactly what it was given. Nothing else
    # looks inside .claude.json, so without this the only record of a bad entry is gone.
    try:
        held = json.load(open(dst_p)).get("mcpServers", {})
    except Exception:
        sys.exit(0)
    if isinstance(held, dict):
        for n in sorted(held):
            r = why(held[n])
            if r:
                print("%s: mcp server %s - %s" % (name, n, r))
    sys.exit(0)

try:
    servers = json.load(open(src_p)).get("mcpServers", {})
except Exception:
    sys.stderr.write("stead: no readable %s - skipping mcp sync\n" % src_p)
    sys.exit(0)
if not isinstance(servers, dict) or not servers:
    print("No user-scoped MCP servers to copy.")
    sys.exit(0)

# Absent is fine and means a fresh profile. PRESENT BUT UNPARSEABLE is not: falling back to {} here
# would rewrite the file and destroy the oauthAccount still sitting in it, recoverable by hand.
try:
    dst = json.load(open(dst_p))
except FileNotFoundError:
    dst = {}
except Exception:
    sys.stderr.write("stead: %s exists but is not readable JSON - refusing to overwrite it\n" % dst_p)
    sys.exit(0)
if not isinstance(dst, dict):
    sys.stderr.write("stead: %s is not a JSON object - refusing to overwrite it\n" % dst_p)
    sys.exit(0)

cur = dst.get("mcpServers", {})
if not isinstance(cur, dict):
    sys.stderr.write("stead: mcpServers in %s is not an object - refusing to touch it\n" % dst_p)
    sys.exit(0)

copied, kept, refused = [], [], []
for n in sorted(servers):
    c = servers[n]
    reason = why(c)
    if reason:
        refused.append((n, reason))
    elif n in cur:
        kept.append(n)
    else:
        cur[n] = dict((k, c[k]) for k in ALLOWED if k in c)
        copied.append(n)
if copied:
    dst["mcpServers"] = cur
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(dst_p) or ".")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(dst, f, indent=2)
        os.replace(tmp, dst_p)
    except Exception:
        try: os.unlink(tmp)
        except OSError: pass
        raise
for n in copied:        print("  + %s" % n)
for n in kept:          print("  = %s (already in profile)" % n)
for n, r in refused:    print("  ! %s - %s" % (n, r))
print("%s: %d copied, %d already there, %d refused" % (name, len(copied), len(kept), len(refused)))
if refused:
    print("Refused entries are not bugs: add them by hand with `claude mcp add` inside the profile,")
    print("so a credential is never copied between accounts.")
if copied:
    print("Restart any running session for this profile - it will otherwise overwrite this change.")
' "$@"
}

cmd_sync_mcp() {
	local name=${1-}
	require_profile "$name"
	mcp_guard sync "$CLAUDE_JSON" "$PROFILES/$name/claude/.claude.json" "$name"
}

cmd_add() {
	local name=${1-}
	valid_name "$name" || die "usage: stead add <name>   (letters, digits, . _ -)"
	[ -d "$PROFILES/$name" ] && die "profile '$name' already exists"
	mkdir -p "$PROFILES/$name/claude" "$PROFILES/$name/codex"
	link_shared "$name"
	cmd_sync_mcp "$name" || warn "mcp sync failed - profile created, run 'stead sync-mcp $name' later"
	cat <<EOF
Created profile '$name'. It shares your config and starts signed out.

  stead login $name          # sign in (opens claude, then run /login)
  stead login $name codex    # same for codex
  stead use $name            # bind the current directory to it
EOF
}

cmd_list() {
	local here name acct mark rc=0
	here=$(resolve) || rc=$?
	[ -d "$PROFILES" ] || { echo "No profiles yet. Create one with: stead add <name>"; return 0; }
	printf '%-16s %-34s %-7s %s\n' PROFILE CLAUDE CODEX ''
	while IFS= read -r name; do
		acct=$(claude_account "$name")
		mark=''
		[ "$name" = "$here" ] && mark='<- active here'
		printf '%-16s %-34s %-7s %s\n' \
			"$name" "${acct:-signed out}" \
			"$([ -f "$PROFILES/$name/codex/auth.json" ] && echo 'authed' || echo '-')" \
			"$mark"
	done < <(profile_names)
	if [ "$rc" -eq 2 ]; then
		printf '\n%s\n' "This directory's $MARKER is unusable (see the warning above) - claude and codex refuse to run here until it is fixed."
	elif [ -z "$here" ]; then
		printf '\n%s\n' "This directory is unbound - claude and codex use your default account."
	fi
	return 0
}

cmd_use() {
	local name=${1-}
	require_profile "$name"
	printf '%s\n' "$name" >"$PWD/$MARKER"
	echo "Bound $PWD to profile '$name'. New claude/codex sessions here will use it."
	echo "Existing sessions keep the account they launched with - restart them to switch."
	if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && ! git check-ignore -q "$MARKER" 2>/dev/null; then
		echo "Note: $MARKER is not gitignored here - committing it would publish the profile name."
	fi
}

cmd_unuse() {
	[ -f "$PWD/$MARKER" ] || die "no $MARKER in $PWD"
	rm "$PWD/$MARKER"
	echo "Unbound $PWD - back to your default account."
}

cmd_which() {
	local name rc=0
	name=$(resolve) || rc=$?
	if [ "$rc" -eq 0 ]; then
		printf '%s\n' "$name"
		return 0
	fi
	[ "$rc" -eq 2 ] && return 2
	[ "${1-}" = "--quiet" ] || echo "unbound (default account)"
	return 1
}

# Runs a command inside a profile. Every other entry point routes through here, so the env contract
# lives in exactly one place.
cmd_run() {
	local name=${1-}
	require_profile "$name"
	shift
	[ $# -gt 0 ] || die "usage: stead run <profile> <command> [args...]"
	# A session registers itself into the SHARED peer registry at startup, and its default name is
	# derived from the directory - so a client repo publishes its own name to every other profile
	# before anyone can rename it, and /title is a cure rather than a prevention. Bound directories
	# get a neutral, stable alias instead: same profile and directory always produce the same one,
	# with no state file. An explicit CLAUDE_CODE_SESSION_NAME always wins, and /title still works.
	# The record's cwd field is untouched - this fixes the address book, not the record.
	local alias=${CLAUDE_CODE_SESSION_NAME:-}
	if [ -z "$alias" ]; then
		alias="$name-$(( $(printf '%s' "$PWD" | cksum | cut -d' ' -f1) % 10000 ))"
	fi
	CLAUDE_CONFIG_DIR="$PROFILES/$name/claude" \
	CODEX_HOME="$PROFILES/$name/codex" \
	CLAUDE_CODE_SESSION_NAME="$alias" \
	STEAD_PROFILE="$name" \
		exec "$@"
}

cmd_login() {
	local name=${1-} tool=${2-claude}
	require_profile "$name"
	case "$tool" in
		claude) echo "Starting claude in profile '$name'. Run /login, then exit." ;;
		codex)  echo "Starting codex in profile '$name'. Sign in, then exit." ;;
		*) die "unknown tool: $tool (expected 'claude' or 'codex')" ;;
	esac
	cmd_run "$name" "$tool"
}

# A symlink replaced by a real file is the known failure mode: an atomic write (temp file + rename)
# clobbers the link and silently unshares that config. Cheap to detect, cheap to repair.
cmd_version() {
	printf 'stead %s\n' "$VERSION"
	printf '  bash     %s\n' "${BASH_VERSION:-unknown}"
	printf '  platform %s %s\n' "$(uname -s)" "$(uname -r)"
	printf '  claude   %s\n' "$(command -v claude >/dev/null 2>&1 && claude --version 2>/dev/null | head -1 || echo 'not on PATH')"
	printf '  codex    %s\n' "$(command -v codex >/dev/null 2>&1 && codex --version 2>/dev/null | head -1 || echo 'not on PATH')"
	printf '  home     %s\n' "$STEAD_HOME"
}

cmd_doctor() {
	local name label src dst broken=0 flagged=0 mcpbad
	[ -d "$PROFILES" ] || { echo "No profiles yet."; return 0; }
	while IFS= read -r name; do
		while IFS=$'\t' read -r label src dst; do
			if [ ! -L "$dst" ]; then
				broken=$((broken + 1))
				printf '%s: %s is %s\n' "$name" "$label" \
					"$([ -e "$dst" ] && echo 'a real file (no longer shared)' || echo 'missing')"
			fi
		done < <(each_shared "$name")
		mcpbad=$(mcp_guard audit "" "$PROFILES/$name/claude/.claude.json" "$name" 2>/dev/null || true)
		if [ -n "$mcpbad" ]; then
			printf '%s\n' "$mcpbad"
			flagged=$((flagged + $(printf '%s\n' "$mcpbad" | wc -l | tr -d ' ')))
		fi
	done < <(profile_names)
	if [ "$broken" -eq 0 ] && [ "$flagged" -eq 0 ]; then
		echo "All profiles share config correctly."
		return 0
	fi
	# Deliberately NOT folded into --fix: relinking cannot fix these, and a --fix that printed
	# success over them would be the fabricated-repair bug this file already fixed once.
	if [ "$flagged" -gt 0 ]; then
		printf '\n%s\n' "$flagged mcp server(s) above would not pass the current copy guard. Remove and re-add them inside the profile: stead run <profile> claude mcp add ..."
	fi
	if [ "$broken" -eq 0 ]; then
		return 0
	fi
	printf '\n%s\n' "$broken link(s) not shared. Re-link with: stead doctor --fix"
	if [ "${1-}" = "--fix" ]; then
		while IFS= read -r name; do
			while IFS=$'\t' read -r label src dst; do
				if [ ! -L "$dst" ]; then
					merge_into_shared "$src" "$dst"
					[ -e "$dst" ] && rm -rf "$dst"
				fi
				:
			done < <(each_shared "$name")
			link_shared "$name"
		done < <(profile_names)
			echo "Re-linked. A profile directory was merged into the shared copy, which wins a collision;"
		echo "a profile FILE that had replaced a shared one is gone."
	fi
	return 0
}

# Emitted for eval in a shell rc. Keeps resolution in this script so there is one implementation.
cmd_shell_init() {
	cat <<'EOF'
_stead_exec() {
	local tool=$1 rc=0 profile
	shift
	profile=$(command stead which --quiet 2>/dev/null) || rc=$?
	if [ "$rc" -eq 2 ]; then
		command stead which --quiet >/dev/null   # re-run unmuted so the reason reaches stderr
		return 2
	fi
	if [ -n "$profile" ]; then
		command stead run "$profile" "$tool" "$@"
	else
		command "$tool" "$@"   # unbound, or stead missing/broken: never block the real binary
	fi
}
claude() { _stead_exec claude "$@"; }
codex()  { _stead_exec codex  "$@"; }
EOF
}

usage() {
	cat <<'EOF'
stead - bind a Claude Code / Codex account to a directory

  stead add <name>              create a profile (shares your config, starts signed out)
  stead login <name> [claude|codex]
                                   sign a profile in
  stead use <name>              bind the current directory (writes .stead)
  stead unuse                   unbind the current directory
  stead list                    profiles, their accounts, and which is active here
  stead which                   the profile governing the current directory
  stead run <name> <cmd>...     run any command inside a profile
  stead doctor [--fix]          check that profiles still share config
  stead version                    versions and paths, for a bug report
  stead sync-mcp <name>         copy your MCP servers into a profile (allowlisted fields only)

Shell integration (zsh/bash) - makes `claude` and `codex` follow the directory:

  eval "$(stead shell-init)"
EOF
}

main() {
	local cmd=${1-}
	[ $# -gt 0 ] && shift
	case "$cmd" in
		add) cmd_add "$@" ;;
		login) cmd_login "$@" ;;
		use) cmd_use "$@" ;;
		unuse) cmd_unuse "$@" ;;
		list | ls) cmd_list "$@" ;;
		which) cmd_which "$@" ;;
		run) cmd_run "$@" ;;
		doctor) cmd_doctor "$@" ;;
		version | --version | -V) cmd_version ;;
		sync-mcp) cmd_sync_mcp "$@" ;;
		shell-init) cmd_shell_init "$@" ;;
		'' | -h | --help | help) usage ;;
		*) usage >&2; die "unknown command: $cmd" ;;
	esac
}

main "$@"
